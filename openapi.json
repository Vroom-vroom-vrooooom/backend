        "summary": "Stage Trip",
        "description": "TripPlan을 소유한 Pleos 기기 큐에 등록합니다.\n\n응답 messageId는 큐 등록 확인입니다. 차량 앱은 사용자 선택과 실제 좌표를 기준으로\nNaviHelper에 목적지·최대 두 경유지를 전달하고, 결과를 SDK 콜백으로 확인해야 합니다.\n여행의 전체 places 목록은 내비게이션의 활성 경유지 목록과 다릅니다.",
        "operationId": "stage_trip_v1_trips__trip_id__stage_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "trip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trip Id"
            }
          },
          {
            "name": "device_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Device Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
