  "components": {
    "schemas": {
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "Device": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "phone",
              "pleos"
            ],
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "title": "Device"
      },
      "DriveEvent": {
        "properties": {
          "v": {
            "type": "integer",
            "const": 1,
            "title": "V",
            "default": 1
          },
          "tripId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Tripid"
          },
          "type": {
            "type": "string",
            "enum": [
              "TRIP_STARTED",
              "PLACE_SAVED",
              "WAYPOINT_APPROVED",
              "WAYPOINT_DECLINED",
              "TRIP_FINISHED"
            ],
            "title": "Type"
          },
          "placeId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Placeid"
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tripId",
          "type",
          "at"
        ],
        "title": "DriveEvent"
      },
      "ExtractionRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Text"
          },
          "source": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Source"
          },
          "group": {
            "type": "string",
            "enum": [
              "좋아요",
              "재생목록",
              "구독",
              "공유"
            ],
            "title": "Group",
            "default": "공유"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "source"
        ],
        "title": "ExtractionRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PairClaim": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "phone",
              "pleos"
            ],
            "title": "Kind"
          },
          "code": {
            "type": "string",
            "maxLength": 100,
            "minLength": 32,
            "title": "Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "kind",
          "code"
        ],
        "title": "PairClaim"
      },
      "Place": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Name"
          },
          "time": {
            "type": "string",
            "maxLength": 100,
            "title": "Time",
            "default": ""
          },
          "duration": {
            "type": "string",
            "maxLength": 100,
            "title": "Duration",
            "default": ""
          },
          "source": {
            "type": "string",
            "maxLength": 500,
            "title": "Source",
            "default": ""
          },
          "group": {
            "type": "string",
            "enum": [
              "좋아요",
              "재생목록",
              "구독",
              "공유",
              ""
            ],
            "title": "Group",
            "default": ""
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "title": "Reason",
            "default": ""
          },
          "distance": {
            "type": "string",
            "maxLength": 100,
            "title": "Distance",
            "default": ""
          },
          "lat": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "lng": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 180.0,
                "minimum": -180.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Lng"
          },
          "open": {
            "type": "string",
            "maxLength": 100,
            "title": "Open",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "Place"
      },
      "RadioRequest": {
        "properties": {
          "place": {
            "$ref": "#/components/schemas/Place"
          },
          "facts": {
            "items": {
